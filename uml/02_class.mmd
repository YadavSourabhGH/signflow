classDiagram
  class StaffUser {
    +userId: String
    +name: String
    +role: String
    +authenticate()
  }
  class File {
    +fileId: String
    +fileType: String
    +amount: Decimal
    +status: FileStatus
    +submittedAt: DateTime
    +submit()
    +changeStatus()
  }
  class ApprovalRoute {
    +routeId: String
    +fileType: String
    +buildRoute()
  }
  class ApprovalStep {
    +stepNo: Integer
    +role: String
    +dueAt: DateTime
    +decision: String
    +recordDecision()
  }
  class DigitalSignature {
    +signatureId: String
    +providerReference: String
    +validationStatus: String
    +request()
    +validate()
  }
  class Reminder {
    +reminderId: String
    +intervalDays: Integer
    +sentAt: DateTime
    +send()
  }
  class AuditEvent {
    +eventId: String
    +eventType: String
    +actorId: String
    +occurredAt: DateTime
    +record()
  }
  class RoutingService {
    +route(file): ApprovalRoute
  }
  class SignatureService {
    +requestSignature(step): DigitalSignature
    +validate(signature): Boolean
  }
  class NotificationService {
    +sendReminder(file, step)
    +escalate(file, step)
  }

  StaffUser "1" --> "0..*" File : submits / handles
  File "1" *-- "1" ApprovalRoute
  ApprovalRoute "1" *-- "1..*" ApprovalStep
  ApprovalStep "0..1" --> "1" DigitalSignature : may require
  File "1" o-- "0..*" Reminder
  File "1" o-- "1..*" AuditEvent
  RoutingService ..> ApprovalRoute : creates
  SignatureService ..> DigitalSignature : manages
  NotificationService ..> Reminder : creates
